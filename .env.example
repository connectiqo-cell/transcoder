# Copy to .env and fill in. NEVER commit the real file.
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key — Settings > API in the Supabase dashboard. Grants full DB access:
# keep it on the server only, never in the app or the website.
SUPABASE_SERVICE_ROLE_KEY=
# Any long random string; must match the value in the database webhook header.
WEBHOOK_SECRET=
PORT=8080
BUCKET=mentor-videos
# Host port Caddy proxies to. Change only if 8080 is already used on the server;
# point the Caddy reverse_proxy at the same value.
HOST_PORT=8080
